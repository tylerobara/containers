---
import Layout from '../../../components/Layout.astro';
import ImageCard from '../../../components/ImageCard.astro';
import { byCategory, categories, categorySlug, categoryHref, images, imageHref, href } from '../../../lib/catalog';

export function getStaticPaths() {
  const grouped = byCategory();
  return categories
    .filter((category) => grouped[category]?.length)
    .map((category) => ({
      params: { slug: categorySlug(category) },
      props: { category, items: grouped[category] },
    }));
}

const { category, items } = Astro.props;
const grouped = byCategory();

const blurbs: Record<string, string> = {
  'Databases': 'PostgreSQL built from PGDG source, one image per major, shaped for CloudNativePG: uid 26, the instance-manager tool contract, and a sha-pinned ClusterImageCatalog.',
  'Kubernetes & Networking': 'Cluster components — operators, CNI and certificate management — compiled from upstream release tarballs with upstream\'s own build flags.',
  'Security & Secrets': 'Secrets management built from source, running as a non-root user with a production-posture default command.',
  'Apps': 'Self-hosted applications packaged from pinned upstream releases on Wolfi\'s CVE-patched runtime packages.',
  'Base & Utilities': 'Helper images for init containers, sidecars and one-off shell tasks — Wolfi packages only, nothing compiled.',
};
const blurb = blurbs[category] ?? `${category} container images built on Wolfi.`;

const title = `${category} images — built from source, scanned and signed`;
const description = `${items.length} ${category.toLowerCase()} container images built with melange and apko on Wolfi, scanned with grype on every build and cosign-signed when clean.`;

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${category} images`,
  numberOfItems: items.length,
  itemListElement: items.map((img: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: img.displayName,
    url: new URL(imageHref(img.slug), Astro.site).href,
  })),
}];
---
<Layout title={title} description={description} schema={schema} breadcrumbs={[{ name: 'Images', href: href('/images/') }]}>
  <section>
    <div class="container">
      <p style="margin:0 0 6px"><a href={href('/images/')} class="small muted">← All {images.length} images</a></p>
      <h1 class="section-title">{category} images</h1>
      <p class="section-sub">{blurb}</p>

      <div class="grid" style="margin-top:28px">
        {items.map((img: any) => <ImageCard image={img} />)}
      </div>

      <h2 class="section-title" style="margin-top:44px;font-size:1.15rem">Other categories</h2>
      <div class="facets" style="margin-top:12px">
        {categories.filter((c) => c !== category && grouped[c]?.length).map((c) => (
          <a class="facet" href={categoryHref(c)}>{c}</a>
        ))}
      </div>

      <p class="small muted" style="margin-top:32px">
        Every image here is checkable from your terminal — see <a href={href('/about/')}>how to verify</a>.
      </p>
    </div>
  </section>
</Layout>
