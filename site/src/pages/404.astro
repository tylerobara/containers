---
import Layout from '../components/Layout.astro';
import { href } from '../lib/catalog';
const imagesUrl = href('/images/');
---
<Layout title="Not found — containers">
  <section class="hero">
    <div class="container-narrow">
      <h1 style="font-size:2.4rem">Page not found</h1>
      <p class="lead">That page moved or never existed. The image catalog is the best place to start.</p>
      <div class="controls" style="max-width:420px;margin:24px auto 0">
        <input id="s404" type="search" placeholder="Search images…" autocomplete="off" data-target={imagesUrl} />
      </div>
      <p style="margin-top:20px"><a class="btn btn-primary" href={imagesUrl}>Browse all images →</a></p>
    </div>
  </section>
  <script>
    const s = document.getElementById('s404') as HTMLInputElement;
    s?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const q = encodeURIComponent(s.value.trim());
        location.href = `${s.dataset.target}${q ? `?q=${q}` : ''}`;
      }
    });
  </script>
</Layout>
